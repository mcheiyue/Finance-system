# 忽略 IDE 配置文件
.idea/
#.vscode/
*.iml
.DS_Store

# 忽略 Node.js 依赖和构建产物
node_modules/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 忽略 Maven 编译产物
target/
mvnw
mvnw.cmd
.mvn/
!finance-tracker/mvnw
!finance-tracker/mvnw.cmd
!finance-tracker/.mvn/
!finance-tracker/.mvn/wrapper/
!finance-tracker/.mvn/wrapper/maven-wrapper.properties
finance-tracker/.mvn/wrapper/maven-wrapper.jar

# 忽略日志
logs/
*.log

# 忽略敏感配置文件
.env
.env.*
*.key
*.pem
*.p12
*.jks
*.keystore
application-local.*
*.sqlite
*.db
docker-compose.override.yml
